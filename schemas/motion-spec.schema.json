{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/motion-spec.schema.json",
  "title": "motion_spec",
  "description": "通用动效规格（Common Motion Specification）：Remotion 与 JianYing 共用的一套动效语义抽象，同语义两后端各自落地（Phase-7 Prompt §39-42）。easing 枚举对齐 motion-family.schema.json；properties 用 §42 motion_property 八枚举；不假定所有后端全支持（§42 通过 Capability Matrix 增加）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "start_frame",
    "end_frame",
    "properties",
    "from",
    "to"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "动效类型（如 slide_in / zoom_in / fade_in，Phase-7 Prompt §40 示例）。"
    },
    "start_frame": {
      "type": "integer",
      "minimum": 0,
      "description": "起始帧（§41）。"
    },
    "end_frame": {
      "type": "integer",
      "minimum": 0,
      "description": "结束帧（§41）。"
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "POSITION_X",
          "POSITION_Y",
          "SCALE",
          "SCALE_X",
          "SCALE_Y",
          "ROTATION",
          "OPACITY",
          "VOLUME"
        ]
      },
      "description": "作用的属性（1..8 项，Phase-7 Prompt §42 motion_property 八枚举）。"
    },
    "from": {
      "type": "object",
      "additionalProperties": true,
      "description": "起始状态（可选键值，如 {x:-0.25, y:0.05, scale:0.96}，§40 示例；键与 properties 对应）。"
    },
    "to": {
      "type": "object",
      "additionalProperties": true,
      "description": "结束状态（如 {x:0, y:0, scale:1.0}）。"
    },
    "easing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "linear",
            "ease",
            "cubic_bezier",
            "spring",
            "custom"
          ],
          "description": "缓动类型（对齐 motion-family.schema.json easing 枚举）：linear=线性；ease=缓动；cubic_bezier=贝塞尔曲线；spring=弹簧；custom=自定义。"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "缓动参数（可选，如 cubic_bezier 四值 [0.16,1,0.3,1]，§40 示例）。"
        }
      },
      "description": "缓动（可选，§41 easing）。"
    },
    "overshoot": {
      "type": "number",
      "description": "回弹超调量（可选，spring/custom 用）。"
    },
    "path": {
      "type": "object",
      "additionalProperties": true,
      "description": "自定义运动路径（可选，§41 path，custom_motion_path 能力）。"
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "max_points"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "ADAPTIVE",
            "FIXED",
            "MANUAL"
          ],
          "description": "采样策略（Phase-7 Prompt §47-48）：ADAPTIVE=按曲线复杂度自适应；FIXED=固定点数；MANUAL=手工指定。"
        },
        "max_points": {
          "type": "integer",
          "minimum": 2,
          "description": "最大采样点数（§48：4/6/8/12 等，禁止每帧一个关键帧）。"
        }
      },
      "description": "采样设置（可选，§41/§47-48）：后端无原生贝塞尔时采样离散关键帧。"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "description": "锚点横坐标（0-1）。"
        },
        "y": {
          "type": "number",
          "description": "锚点纵坐标（0-1）。"
        }
      },
      "description": "锚点（可选，§41 anchor）。"
    },
    "relative_to": {
      "type": "string",
      "description": "相对参考（可选，§41 relative_to，如 clip / track / canvas）。"
    },
    "backend_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "type": "string",
          "enum": [
            "REMOTION",
            "JY_NATIVE",
            "EITHER"
          ],
          "description": "首选落地后端（Phase-7 Prompt §51-52）：REMOTION=复杂动效烘焙成 Remotion Asset；JY_NATIVE=简单动效留给剪映原生关键帧；EITHER=均可。"
        },
        "reason": {
          "type": "string",
          "description": "选择理由（可选，§51 升级规则 / §52 降级规则记录）。"
        }
      },
      "description": "后端偏好（可选，§41 backend_preferences）。"
    },
    "quality": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "description": "动效质量（可选，LOW/MEDIUM/HIGH）：影响采样点数与烘焙决策。"
    }
  }
}
