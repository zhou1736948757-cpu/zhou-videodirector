            "owner": {
              "type": "string",
              "description": "承担方（可选；如 overlay 的 REMOTION/JY_NATIVE，对齐 packet_builder 实际输出，R4）。"
            }
          },
          "description": "转场计划（§49）：{required, note}。"
        }
      },
      "description": "后期计划（§49 十项）：生成视频不是 Final，此计划告知后续如何处理；每项 {required:boolean, note:string}，可带可选 owner:string（承担方，如 overlay 的 REMOTION/JY_NATIVE；对齐 packet_builder 实际输出，FR-008/R4）。"
    },
    "negative_constraints": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      },
      "description": "负面约束清单（明确禁止出现的内容）。"
    },
    "model_ready_prompt": {
      "type": "string",
      "description": "模型可直接消费的完整提示词（由 Packet 确定性归一化生成，Provider-neutral §25）。"
    },
    "negative_prompt": {
      "type": "string",
      "description": "负面提示词。"
    },
    "variant_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "risk_level",
        "hero_shot",
        "rationale"
      ],
      "properties": {
        "range": {
          "type": "string",
          "enum": [
            "ONE_TO_TWO",
            "TWO_TO_FOUR"
          ],
          "description": "变体数量档（§33 2 枚举）：1–2 或 2–4，按风险决定，禁止默认 generate 10 variants。"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "description": "生成风险（§34：成本/镜头重要性/prompt 不确定性/连续性难度/人物/复杂运动）。"
        },
        "hero_shot": {
          "type": "boolean",
          "description": "是否为 Hero Shot（hero 可多一点变体，§34）。"
        },
        "rationale": {
          "type": "string",
          "description": "档位选择理由（为什么这个范围）。"
        }
      },
      "description": "变体策略（§33-34）。"
    },
    "recommended_variant_count": {
      "type": "integer",
      "minimum": 1,
      "description": "建议生成变体数（确定性数值，供成本预估 §31）。"
    },
    "reference_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_image": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "参考图。"
        },
        "style_frame": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "风格帧。"
        },
        "character_reference": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "角色参考（§24，上传涉及隐私须过 Data/Privacy Gate §32）。"
        },
        "environment_reference": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "环境参考。"
        },
        "product_reference": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "产品参考。"
        },
        "previous_generated_frame": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/reference_entry"
          },
          "description": "上一版生成帧（连续性/回归参考）。"
        }
      },
      "description": "参考输入（§24 六类，各为引用条目数组；不要求所有 Provider 支持全部类型，兼容性由 Adapter 决定）。"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^GV-\\d{3}$",
      "description": "被本版本替代的旧 Packet ID（可选，指向旧版 packet_id，不换 ID 只加版本，§90-91）。"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "model_ready_prompt + negative_prompt 规范化 JSON 的 sha256（可选，参照 modules/production/planner.py spec hash 语义）。"
    },
    "generation_notes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      },
      "description": "生成备注清单（array of strings）：Provider 选择/注意事项/人工流程提示/overload 标记等（对齐 packet_builder 实际输出，FR-011）。结构化记录（如 PRODUCTION_CONFLICT PC-###）一律落独立文件，此字段只写记录 id 引用，禁止整块 JSON 字符串塞入（FR-025）。"
    },
    "review_criteria": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      },
      "description": "评审标准（§36 18 维度名清单，如 prompt_adherence/composition/...，见 video-review.schema.json dimensions；对齐 packet_builder 实际输出，FR-012）。"
    }
  },
  "definitions": {
    "reference_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "path_or_url",
        "purpose",
        "required"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^RF-\\d{3}$",
          "description": "参考条目 ID，格式 RF-###（Reference Frame Bank 引用，§125-127）。"
        },
        "path_or_url": {
          "type": "string",
          "description": "参考文件路径或 URL。"
        },
        "purpose": {
          "type": "string",
          "description": "该参考的用途（如 角色外观锚点 / 环境风格锚点）。"
        },
        "required": {
          "type": "boolean",
          "description": "是否硬性要求（false=可选参考）。"
        }
      }
    }
  }
}
