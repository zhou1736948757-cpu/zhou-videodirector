        "people": {
          "type": "string",
          "description": "人员动效。"
        },
        "cloth": {
          "type": "string",
          "description": "布料动效。"
        },
        "hair": {
          "type": "string",
          "description": "头发动效。"
        },
        "smoke": {
          "type": "string",
          "description": "烟雾动效。"
        },
        "water": {
          "type": "string",
          "description": "水动效。"
        },
        "plants": {
          "type": "string",
          "description": "植物动效。"
        },
        "crowd": {
          "type": "string",
          "description": "人群动效。"
        },
        "ambient_objects": {
          "type": "string",
          "description": "环境物件动效。"
        }
      },
      "description": "环境有机运动（§18）：8 键分类对象 people/cloth/hair/smoke/water/plants/crowd/ambient_objects，各为字符串；未指定项写空串（对齐 packet_builder 实际输出，FR-005）。"
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_direction": {
          "type": "string",
          "description": "光源方向。"
        },
        "softness": {
          "type": "string",
          "description": "软/硬光。"
        },
        "contrast": {
          "type": "string",
          "description": "对比度。"
        },
        "temperature": {
          "type": "string",
          "description": "色温。"
        },
        "practical": {
          "type": "boolean",
          "description": "是否存在实景/实用光源（§19）：true=有实景光源；false=无。"
        },
        "volumetric": {
          "type": "boolean",
          "description": "是否存在体积光（§19）：true=有体积光；false=无。"
        },
        "shadows": {
          "type": "string",
          "description": "阴影行为（§19）。"
        }
      },
      "description": "灯光（§19）。"
    },
    "time_of_day": {
      "type": "string",
      "description": "时段（如 黄昏 / 夜间）。"
    },
    "mood": {
      "type": "string",
      "description": "情绪基调。"
    },
    "style": {
      "type": "string",
      "description": "风格（引用 VISUAL_BIBLE 风格标签）。"
    },
    "material_character": {
      "type": "string",
      "description": "材质性格：主体/环境表面材质质感。"
    },
    "color_direction": {
      "type": "string",
      "description": "色彩方向：主色/辅色/色板趋势。"
    },
    "motion_character": {
      "type": "string",
      "description": "运动性格（§20 继承 Visual Bible，禁止默认 dramatic cinematic motion）：如 calm / restrained / dreamlike / energetic / documentary / precise / organic。"
    },
    "start_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "kind"
      ],
      "properties": {
        "state": {
          "type": "string",
          "description": "起始帧画面状态描述（§21）：有 Continuity Requirement 时必填，如 close shot of single memory card。"
        },
        "source": {
          "type": "string",
          "description": "状态来源（ev_requirement=来自 EV 请求；derived_default=引擎缺省推导）。"
        },
        "kind": {
          "type": "string",
          "description": "帧类别（START=起始帧；END=结束帧）。"
        },
        "changes_scene": {
          "type": "boolean",
          "description": "是否发生场景切换（可选；ev start_frame_requirement 带 changes_scene 时输出，对齐 packet_builder 实际输出，R4）。"
        }
      },
      "description": "起始帧状态（§21）：对象结构 {state, source, kind}，可带可选 changes_scene（对齐 packet_builder 实际输出，FR-007/R4）。"
    },
    "end_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source",
        "kind"
      ],
      "properties": {
        "state": {
          "type": "string",
          "description": "结束帧画面状态描述（§21）：如 camera reveals entire museum hall。"
        },
        "source": {
          "type": "string",
          "description": "状态来源（ev_requirement / derived_default）。"
        },
        "kind": {
          "type": "string",
          "description": "帧类别（START=起始帧；END=结束帧）。"
        },
        "changes_scene": {
          "type": "boolean",
          "description": "是否发生场景切换（可选；ev end_frame_requirement 带 changes_scene 时输出，对齐 packet_builder 实际输出，R4）。"
        }
      },
      "description": "结束帧状态（§21）：对象结构 {state, source, kind}，可带可选 changes_scene（对齐 packet_builder 实际输出，FR-007/R4）。"
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_identity": {
          "type": "string",
          "description": "主体身份（§22）。"
        },
        "wardrobe": {
          "type": "string",
          "description": "服装。"
        },
        "environment": {
          "type": "string",
          "description": "环境。"
        },
        "lighting": {
          "type": "string",
          "description": "灯光。"
        },
        "camera_direction": {
          "type": "string",
          "description": "机位方向。"
        },
        "movement_direction": {
          "type": "string",
          "description": "运动方向。"
        },
        "screen_direction": {
          "type": "string",
          "description": "银幕方向（§23）。"
        },
        "object_position": {
          "type": "string",
          "description": "物体位置。"
        },
        "time_of_day": {
          "type": "string",
          "description": "时段。"
        },
        "color": {
          "type": "string",
          "description": "色彩。"
        }
      },
      "description": "连续性记录（§22 十项 Checklist）。"
    },
    "previous_shot_context": {
      "type": "string",
      "description": "上一镜上下文（可选，§23 银幕方向：subject moves left→right）。"
    },
    "next_shot_context": {
      "type": "string",
      "description": "下一镜上下文（可选，§23，避免无理由 reverse）。"
    },
    "text_safe_area": {
      "type": "string",
      "description": "文字安全区（§14）：如 Right 35% of frame remains visually quiet。"
    },
    "overlay_safe_area": {
      "type": "string",
      "description": "叠加安全区：为后期 Remotion / 3D / 图形预留的安静且稳定的区域（§50-51）。"
