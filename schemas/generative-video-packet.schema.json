{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/generative-video-packet.schema.json",
  "title": "generative_video_packet",
  "description": "生成视频生产包：GENERATIVE VIDEO PRODUCTION PACKET 的数据契约（Phase-6 Prompt §9）。任何 AI Video 镜头必须先产生完整 Packet 再生成，禁止只写一句“cinematic …”式描述。Packet 是 Provider-neutral（§25 不写死任何具体视频模型），先描述镜头为何存在（purpose，§10）、主体/环境/构图/相机/灯光/运动/连续性（§11-23），再给出模型可直接消费的 model_ready_prompt 与 negative_prompt、变体策略（§33-34）、参考输入（§24）与评审标准（§36）。版本演化用 packet_version 递增 + supersedes 指向旧版，不换 packet_id（§90-91）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "packet_version",
    "request_id",
    "shot_id",
    "layer_id",
    "purpose",
    "duration",
    "aspect_ratio",
    "resolution",
    "fps",
    "subject",
    "environment",
    "composition",
    "framing",
    "camera",
    "lens",
    "camera_movement",
    "subject_action",
    "environment_motion",
    "lighting",
    "time_of_day",
    "mood",
    "style",
    "material_character",
    "color_direction",
    "motion_character",
    "start_frame",
    "end_frame",
    "continuity",
    "text_safe_area",
    "overlay_safe_area",
    "postproduction_plan",
    "negative_constraints",
    "model_ready_prompt",
    "negative_prompt",
    "variant_strategy",
    "recommended_variant_count",
    "reference_inputs",
    "generation_notes",
    "review_criteria"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^GV-\\d{3}$",
      "description": "生产包 ID，格式 GV-###；版本演化不换 ID，用 packet_version + supersedes（§91）。"
    },
    "packet_version": {
      "type": "integer",
      "minimum": 1,
      "description": "生产包版本（1..n，§91 Prompt Versioning）。"
    },
    "request_id": {
      "type": "string",
      "pattern": "^EV-\\d{3}$",
      "description": "回链 external-visual-request.request_id（EV-###）。"
    },
    "shot_id": {
      "type": "string",
      "description": "关联 Shot ID（已批准 Storyboard，§3）。"
    },
    "layer_id": {
      "type": "string",
      "description": "关联 Layer ID（如 S###-L##）。"
    },
    "purpose": {
      "type": "string",
      "description": "镜头为何存在：叙事/画面职责（§10 Prompt Builder 首先回答 purpose，换模型仍知道核心目标）。"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "时长（秒）。"
    },
    "aspect_ratio": {
      "type": "string",
      "description": "画幅比，如 16:9。"
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "description": "宽度（像素）。"
        },
        "h": {
          "type": "integer",
          "description": "高度（像素）。"
        }
      },
      "description": "分辨率（像素）。"
    },
    "fps": {
      "type": "number",
      "description": "帧率。"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "who_what"
      ],
      "properties": {
        "who_what": {
          "type": "string",
          "description": "谁/什么可见：类型/年龄/材质/形状（§11）。"
        },
        "prominence": {
          "type": "string",
          "description": "主体显著性。"
        },
        "must_stay_stable": {
          "type": "string",
          "description": "必须保持稳定的外观属性。"
        }
      },
      "description": "主体（复用 external-visual-request.subject 结构，§11）。"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "description": "地点。"
        },
        "architecture": {
          "type": "string",
          "description": "建筑/结构特征。"
        },
        "spatial_scale": {
          "type": "string",
          "description": "空间尺度。"
        },
        "foreground": {
          "type": "string",
          "description": "前景元素。"
        },
        "midground": {
          "type": "string",
          "description": "中景元素。"
        },
        "background": {
          "type": "string",
          "description": "背景元素。"
        },
        "density": {
          "type": "string",
          "description": "场景密度。"
        },
        "weather": {
          "type": "string",
          "description": "天气。"
        },
        "atmosphere": {
          "type": "string",
          "description": "氛围。"
        },
        "surface_materials": {
          "type": "string",
          "description": "表面材质。"
        },
        "environmental_motion": {
          "type": "string",
          "description": "环境有机运动（§18）。"
        }
      },
      "description": "环境（复用 external-visual-request.environment 结构，§12）。"
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_placement": {
          "type": "string",
          "description": "主体位置。"
        },
        "negative_space": {
          "type": "string",
          "description": "留白/负空间。"
        },
        "visual_hierarchy": {
          "type": "string",
          "description": "视觉层级。"
        },
        "depth_layers": {
          "type": "string",
          "description": "纵深分层。"
        },
        "safe_zones": {
          "type": "string",
          "description": "安全区。"
        },
        "intended_overlay_area": {
          "type": "string",
          "description": "预留叠加区。"
        }
      },
      "description": "构图（§13）。"
    },
    "framing": {
      "type": "string",
      "description": "取景描述：机位/画幅内主体关系与边界。"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shot_size": {
          "type": "string",
          "description": "景别。"
        },
        "height": {
          "type": "string",
          "description": "机位高度。"
        },
        "angle": {
          "type": "string",
          "description": "角度。"
        },
        "movement_speed": {
          "type": "string",
          "description": "运镜速度。"
        },
        "stabilization": {
          "type": "string",
          "description": "稳定风格（§15）。"
        }
      },
      "description": "相机参数（§15；lens 与 camera_movement 为独立顶层字段，见下）。"
    },
    "lens": {
      "type": "string",
      "enum": [
        "WIDE",
        "NORMAL",
        "TELEPHOTO",
        "MACRO",
        "SHALLOW_DOF",
        "DEEP_FOCUS"
      ],
      "description": "镜头性格（§16 6 枚举）：只有必要时才给近似焦段，禁止无意义硬塞。"
    },
    "camera_movement": {
      "type": "string",
      "enum": [
        "STATIC",
        "PUSH_IN",
        "PULL_OUT",
        "PAN",
        "TILT",
        "ORBIT",
        "DOLLY",
        "TRACKING",
        "CRANE",
        "HANDHELD",
        "POV",
        "COMPLEX",
        "CUSTOM"
      ],
      "description": "运镜（§17 13 枚举）。"
    },
    "subject_action": {
      "type": "string",
      "description": "主体动作：具体行为/姿态变化，拒绝模糊描述。"
    },
    "environment_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people",
        "cloth",
        "hair",
        "smoke",
        "water",
        "plants",
        "crowd",
        "ambient_objects"
      ],
