{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/layer.schema.json",
  "title": "layer",
  "description": "图层：镜头内部独立的生产技术单元，一个镜头可由多个不同 route 的图层组成（Phase-1 Prompt §24 / 总设计 §20）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "shot_id",
    "name",
    "role",
    "z_order",
    "type",
    "visual_description",
    "route",
    "producer",
    "blend_mode",
    "alpha",
    "position",
    "scale",
    "rotation",
    "motion",
    "audio_relation",
    "editable",
    "baked",
    "dependencies",
    "approval",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^L\\d{3}$",
      "description": "图层 ID，格式 L###。"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^S\\d{3}$",
      "description": "所属镜头 ID，格式 S###，引用 shot.id。"
    },
    "name": {
      "type": "string",
      "description": "图层名称。"
    },
    "role": {
      "type": "string",
      "enum": [
        "BACKGROUND",
        "FOREGROUND",
        "SUBJECT",
        "TYPOGRAPHY",
        "UI",
        "DATA",
        "3D_OBJECT",
        "PARTICLE",
        "DECORATION",
        "FOOTAGE",
        "IMAGE",
        "OVERLAY",
        "MASK",
        "LIGHTING",
        "ATMOSPHERE",
        "SUBTITLE"
      ],
      "description": "图层角色（16 种枚举，Phase-3 §25）。"
    },
    "z_order": {
      "type": "integer",
      "description": "层级顺序。"
    },
    "type": {
      "type": "string",
      "enum": [
        "TEXT",
        "OVERLAY",
        "BG",
        "3D_OBJECT",
        "SFX",
        "ASSEMBLY",
        "OTHER"
      ],
      "description": "图层类型。"
    },
    "visual_description": {
      "type": "string",
      "description": "视觉描述。"
    },
    "route": {
      "type": "string",
      "enum": [
        "REMOTION",
        "THREE_D",
        "REAL_FOOTAGE",
        "GENERATIVE_VIDEO",
        "JY_NATIVE",
        "HYBRID",
        "UNDECIDED"
      ],
      "description": "图层技术路由。"
    },
    "producer": {
      "type": "string",
      "description": "生产者（工具/模块）。"
    },
    "blend_mode": {
      "type": "string",
      "description": "混合模式。"
    },
    "alpha": {
      "type": "boolean",
      "description": "是否带透明通道。"
    },
    "position": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "description": "x 坐标。"
            },
            "y": {
              "type": "number",
              "description": "y 坐标。"
            }
          }
        },
        {
          "type": "string",
          "description": "位置说明文本。"
        }
      ],
      "description": "位置（{x, y} 或字符串说明）。"
    },
    "scale": {
      "oneOf": [
        {
          "type": "number",
          "description": "缩放比例。"
        },
        {
          "type": "string",
          "description": "缩放说明文本。"
        }
      ],
      "description": "缩放。"
    },
    "rotation": {
      "oneOf": [
        {
          "type": "number",
          "description": "旋转角度（度）。"
        },
        {
          "type": "string",
          "description": "旋转说明文本。"
        }
      ],
      "description": "旋转。"
    },
    "motion": {
      "type": "string",
      "description": "图层动效说明。"
    },
    "audio_relation": {
      "type": "string",
      "description": "音频关联。"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^A\\d{3}$",
      "description": "关联资产 ID，格式 A###，引用 asset.asset_id（可选）。"
    },
    "editable": {
      "type": "boolean",
      "description": "是否可编辑。"
    },
    "baked": {
      "type": "boolean",
      "description": "是否已烘焙。注意：editable 与 baked 至少一为 false（validator 检查，schema 不强约束）。"
    },
    "bake_policy": {
      "type": "string",
      "enum": [
        "BAKE",
        "KEEP_EDITABLE",
        "ASSET_REPLACEABLE"
      ],
      "description": "烘焙策略（Phase-3 §30）：BAKE=整体烘焙，时间线内无需再改；KEEP_EDITABLE=保持时间线可调；ASSET_REPLACEABLE=内部烘焙但整个 Asset 可替换。"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "依赖类型。"
          },
          "target_id": {
            "type": "string",
            "description": "依赖目标 ID。"
          }
        }
      },
      "description": "图层依赖列表。"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "status"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^AP-\\d{3}$",
          "description": "审批 ID，格式 AP-###，引用 approval.approval_id。"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "revision_requested",
            "superseded"
          ],
          "description": "审批状态。"
        }
      },
      "description": "图层审批引用。"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "waiting_user",
        "approved",
        "completed",
        "skipped",
        "blocked",
        "failed",
        "superseded"
      ],
      "description": "图层状态。"
    }
  }
}
